{
  "name": "claugem",
  "version": "0.1.0",
  "description": "Claugem — самообучающийся ИИ-агент для Mac (Electron + React)",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env CLAUGEM_DEV=1 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --mac"
  },
  "build": {
    "appId": "com.claugem.app",
    "productName": "Claugem",
    "files": ["dist/**", "electron/**", "package.json"],
    "mac": { "category": "public.app-category.developer-tools", "target": ["dmg"] }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
